# Docker log files written at runtime — keep the .gitkeep placeholders but
# ignore everything else that nginx and php-fpm drop into these directories.
/docker/logs/nginx/*
!/docker/logs/nginx/.gitkeep
/docker/logs/php-fpm/*
!/docker/logs/php-fpm/.gitkeep

# TLS material generated by docker/nginx/ssl/generate-keys.sh or nginx startup.sh
# (this rule is already present in docker/nginx/ssl/.gitignore, but a top-level
# entry makes it visible to tools that only inspect the root .gitignore).
/docker/nginx/ssl/*.crt
/docker/nginx/ssl/*.key
/docker/nginx/ssl/*.csr
/docker/nginx/ssl/*.pem

# docker-laravel-config generate.sh conflict output — hand-edit detected; see README
*.new

# docker.answers.json is committed so it can be used to regenerate; the
# docker .env fragment is printed to stdout and must be pasted into .env manually.
