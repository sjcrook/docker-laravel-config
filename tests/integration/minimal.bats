#!/usr/bin/env bats
# Integration — minimal.answers.json (tech §20: minimal.bats)

setup() {
    REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
    TEST_OUT="$(mktemp -d)"
}

teardown() {
    rm -rf "${TEST_OUT}"
}

@test "minimal: exits 0" {
    run "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}"
    [ "$status" -eq 0 ]
}

@test "minimal: all 16 output paths exist" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    local expected=(
        docker-compose.yml
        sail
        docker/nginx/Dockerfile
        docker/nginx/nginx.conf
        docker/nginx/startup.sh
        docker/nginx/logrotate/nginx
        docker/nginx/sites/laravel.conf
        docker/nginx/ssl/.gitignore
        docker/nginx/ssl/generate-keys.sh
        docker/php-fpm/Dockerfile
        docker/php-fpm/laravel.ini
        docker/php-fpm/php-fpm-pool.conf
        docker/php-fpm/docker-entrypoint.sh
        docker/logs/nginx/.gitkeep
        docker/logs/php-fpm/.gitkeep
        docker.answers.json
    )
    for f in "${expected[@]}"; do
        [ -f "${TEST_OUT}/${f}" ] || { echo "missing: $f"; false; }
    done
    # 16 spec output paths plus the root .gitignore appended by append_gitignore.
    [ -f "${TEST_OUT}/.gitignore" ]
    [ "$(find "${TEST_OUT}" -type f | wc -l)" -eq 17 ]
}

@test "minimal: docker.answers.json is valid JSON" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    jq -e . "${TEST_OUT}/docker.answers.json" >/dev/null
}

@test "minimal: defaults applied (memoryLimit=256M, default ports)" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    [ "$(jq -r '.memoryLimit' "${TEST_OUT}/docker.answers.json")" = "256M" ]
    [ "$(jq -r '.hostHttpPort' "${TEST_OUT}/docker.answers.json")" = "80" ]
    [ "$(jq -r '.hostHttpsPort' "${TEST_OUT}/docker.answers.json")" = "443" ]
    [ "$(jq -r '.hostSshPort' "${TEST_OUT}/docker.answers.json")" = "2222" ]
    [ "$(jq -r '.hostPgAdminPort' "${TEST_OUT}/docker.answers.json")" = "8081" ]
    [ "$(jq -r '.hostVitePort' "${TEST_OUT}/docker.answers.json")" = "5173" ]
}

@test "minimal: generated files have two-line header" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    for f in docker-compose.yml docker/php-fpm/Dockerfile; do
        [[ "$(sed -n 1p "${TEST_OUT}/${f}")" == "# Generated by docker-laravel-config"* ]]
        sed -n 2p "${TEST_OUT}/${f}" | grep -qE 'Source: docker\.answers\.json  Hash: [0-9a-f]{64}$'
    done
    [[ "$(sed -n 1p "${TEST_OUT}/docker/php-fpm/laravel.ini")" == "; Generated by docker-laravel-config"* ]]
}

@test "minimal: invariant files have no header" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    for f in sail docker/nginx/Dockerfile docker/nginx/startup.sh docker/php-fpm/docker-entrypoint.sh; do
        ! grep -q 'Hash: [0-9a-f]\{64\}' "${TEST_OUT}/${f}"
    done
}

@test "minimal: sail and generate-keys.sh are executable" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    [ -x "${TEST_OUT}/sail" ]
    [ -x "${TEST_OUT}/docker/nginx/ssl/generate-keys.sh" ]
}

@test "minimal: .gitkeep files exist and are empty" {
    "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}" >/dev/null
    [ -f "${TEST_OUT}/docker/logs/nginx/.gitkeep" ]
    [ ! -s "${TEST_OUT}/docker/logs/nginx/.gitkeep" ]
    [ -f "${TEST_OUT}/docker/logs/php-fpm/.gitkeep" ]
    [ ! -s "${TEST_OUT}/docker/logs/php-fpm/.gitkeep" ]
}

@test "minimal: stdout contains NGINX_SERVER_NAME=myapp.local" {
    run "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}"
    [[ "$output" == *"NGINX_SERVER_NAME=myapp.local"* ]]
}

@test "minimal: stdout contains VITE_DEV_SERVER_PORT=5173" {
    run "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}"
    [[ "$output" == *"VITE_DEV_SERVER_PORT=5173"* ]]
}

@test "minimal: stdout contains DB NOTE: reminder" {
    run "${REPO_ROOT}/generate.sh" --answers "${REPO_ROOT}/examples/minimal.answers.json" --out-dir "${TEST_OUT}"
    [[ "$output" == *"NOTE:"* ]]
}
