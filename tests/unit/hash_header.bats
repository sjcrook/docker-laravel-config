#!/usr/bin/env bats
# T24 — write_header() and check_hand_edit() (tech §12)

setup() {
    REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
    source "${REPO_ROOT}/generate.sh"
    set +e
    TMP="$(mktemp -d)"
    FORCE=false
    mkdir -p "$TMP/out" "$TMP/stage"
}

teardown() {
    rm -rf "$TMP"
}

# make_generated <path> <content> — rendered content + header
make_generated() {
    printf '%s\n' "$2" > "$1"
    write_header "$1" "docker.answers.json"
}

@test "write_header: prepends exactly two lines" {
    set -e
    printf 'a\nb\n' > "$TMP/f.yml"
    write_header "$TMP/f.yml" "docker.answers.json"
    [ "$(wc -l < "$TMP/f.yml")" -eq 4 ]
    [ "$(tail -n +3 "$TMP/f.yml")" = $'a\nb' ]
    [[ "$(sed -n 1p "$TMP/f.yml")" == "# Generated by docker-laravel-config"* ]]
}

@test "write_header: line 2 contains Source and a 64-char hex hash" {
    set -e
    printf 'a\n' > "$TMP/f.yml"
    write_header "$TMP/f.yml" "docker.answers.json"
    sed -n 2p "$TMP/f.yml" | grep -qE 'Source: docker\.answers\.json  Hash: [0-9a-f]{64}$'
}

@test "write_header: hash equals SHA-256 of original content" {
    set -e
    printf 'hello\nworld\n' > "$TMP/f.yml"
    expected="$(sha256_file "$TMP/f.yml")"
    write_header "$TMP/f.yml" "docker.answers.json"
    [[ "$(sed -n 2p "$TMP/f.yml")" == *"Hash: ${expected}" ]]
    [ "$(tail -n +3 "$TMP/f.yml" | wc -c)" -eq 12 ]
}

@test "write_header: uses ';' comment char for .ini files" {
    set -e
    printf 'memory_limit = 1\n' > "$TMP/laravel.ini"
    write_header "$TMP/laravel.ini" "docker.answers.json"
    [[ "$(sed -n 1p "$TMP/laravel.ini")" == "; Generated"* ]]
    [[ "$(sed -n 2p "$TMP/laravel.ini")" == "; Source:"* ]]
}

@test "check_hand_edit: returns 0 for a new file" {
    make_generated "$TMP/stage/f.yml" "x"
    run check_hand_edit "$TMP/out/f.yml" "$TMP/stage/f.yml"
    [ "$status" -eq 0 ]
    [ ! -e "$TMP/out/f.yml.new" ]
}

@test "check_hand_edit: returns 0 for an unmodified generated file" {
    make_generated "$TMP/out/f.yml" "x"
    make_generated "$TMP/stage/f.yml" "y"
    run check_hand_edit "$TMP/out/f.yml" "$TMP/stage/f.yml"
    [ "$status" -eq 0 ]
    [ ! -e "$TMP/out/f.yml.new" ]
}

@test "check_hand_edit: returns 0 for an unmodified .ini file" {
    printf 'a=1\n' > "$TMP/out/laravel.ini"
    write_header "$TMP/out/laravel.ini" "docker.answers.json"
    printf 'a=2\n' > "$TMP/stage/laravel.ini"
    write_header "$TMP/stage/laravel.ini" "docker.answers.json"
    run check_hand_edit "$TMP/out/laravel.ini" "$TMP/stage/laravel.ini"
    [ "$status" -eq 0 ]
}

@test "check_hand_edit: returns 0 for an existing file with no header" {
    printf 'plain\n' > "$TMP/out/f.yml"
    make_generated "$TMP/stage/f.yml" "y"
    run check_hand_edit "$TMP/out/f.yml" "$TMP/stage/f.yml"
    [ "$status" -eq 0 ]
    [ ! -e "$TMP/out/f.yml.new" ]
}

@test "check_hand_edit: modified file with FORCE=false returns 1 and writes .new" {
    make_generated "$TMP/out/f.yml" "x"
    echo "hand edit" >> "$TMP/out/f.yml"
    cp "$TMP/out/f.yml" "$TMP/out/f.yml.orig"
    make_generated "$TMP/stage/f.yml" "y"
    run check_hand_edit "$TMP/out/f.yml" "$TMP/stage/f.yml"
    [ "$status" -eq 1 ]
    [ -f "$TMP/out/f.yml.new" ]
    cmp "$TMP/out/f.yml.new" "$TMP/stage/f.yml"
    cmp "$TMP/out/f.yml" "$TMP/out/f.yml.orig"
}

@test "check_hand_edit: modified file with FORCE=true returns 0 and writes no .new" {
    make_generated "$TMP/out/f.yml" "x"
    echo "hand edit" >> "$TMP/out/f.yml"
    make_generated "$TMP/stage/f.yml" "y"
    FORCE=true
    run check_hand_edit "$TMP/out/f.yml" "$TMP/stage/f.yml"
    [ "$status" -eq 0 ]
    [ ! -e "$TMP/out/f.yml.new" ]
}
