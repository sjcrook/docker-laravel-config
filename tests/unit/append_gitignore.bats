#!/usr/bin/env bats
# T035 — append_gitignore() (functional-spec §6, tech §16)

setup() {
    REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
    source "${REPO_ROOT}/generate.sh"
    set +e
    TMP="$(mktemp -d)"
    TEMPLATE="${REPO_ROOT}/templates/gitignore.append"
}

teardown() {
    rm -rf "$TMP"
}

@test "append_gitignore: creates a missing .gitignore with every non-blank template line" {
    run append_gitignore "$TMP"
    [ "$status" -eq 0 ]
    [ -f "$TMP/.gitignore" ]
    local line
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        grep -qxF -- "$line" "$TMP/.gitignore" || { echo "missing: $line"; false; }
    done < "$TEMPLATE"
}

@test "append_gitignore: reports how many lines were appended on the first run" {
    run append_gitignore "$TMP"
    [ "$status" -eq 0 ]
    [[ "$output" == *".gitignore: "*" line(s) appended"* ]]
}

@test "append_gitignore: keeps existing lines in order and adds only missing template lines" {
    printf '%s\n' 'node_modules' '.env' '*.new' > "$TMP/.gitignore"
    run append_gitignore "$TMP"
    [ "$status" -eq 0 ]
    # The project's own lines stay first, in their original order.
    [ "$(sed -n 1p "$TMP/.gitignore")" = "node_modules" ]
    [ "$(sed -n 2p "$TMP/.gitignore")" = ".env" ]
    [ "$(sed -n 3p "$TMP/.gitignore")" = "*.new" ]
    # '*.new' was already present, so it must not be duplicated.
    [ "$(grep -cxF -- '*.new' "$TMP/.gitignore")" -eq 1 ]
    # A template line that was missing has been added.
    grep -qxF -- '/docker/logs/nginx/*' "$TMP/.gitignore"
}

@test "append_gitignore: second run changes nothing and prints no appended message" {
    append_gitignore "$TMP" >/dev/null
    cp "$TMP/.gitignore" "$TMP/.gitignore.before"
    run append_gitignore "$TMP"
    [ "$status" -eq 0 ]
    [[ "$output" != *"line(s) appended"* ]]
    cmp "$TMP/.gitignore" "$TMP/.gitignore.before"
}

@test "append_gitignore: writes no generated header" {
    append_gitignore "$TMP" >/dev/null
    ! grep -q 'Generated by' "$TMP/.gitignore"
}
