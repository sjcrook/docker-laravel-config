#!/usr/bin/env bats
# T025 — copy_invariant() and stage_files() (functional-spec §6, tech §16 steps 8-15)

setup() {
    REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
    source "${REPO_ROOT}/generate.sh"
    set +e
    TMP="$(mktemp -d)"
    OUT_DIR="$TMP/out"
    STAGE_DIR="$TMP/stage"
    mkdir -p "$OUT_DIR" "$STAGE_DIR"
    FORCE=false
    load_answers "${REPO_ROOT}/examples/full.answers.json"
    validate_answers
    resolve_blocks
    export_tokens
}

teardown() {
    rm -rf "$TMP"
}

EXPECTED_FILES=(
    docker-compose.yml
    sail
    docker/nginx/Dockerfile
    docker/nginx/nginx.conf
    docker/nginx/startup.sh
    docker/nginx/logrotate/nginx
    docker/nginx/sites/laravel.conf
    docker/nginx/ssl/.gitignore
    docker/nginx/ssl/generate-keys.sh
    docker/php-fpm/Dockerfile
    docker/php-fpm/laravel.ini
    docker/php-fpm/php-fpm-pool.conf
    docker/php-fpm/docker-entrypoint.sh
    docker/logs/nginx/.gitkeep
    docker/logs/php-fpm/.gitkeep
)

@test "copy_invariant: copies verbatim, preserving relative path" {
    set -e
    copy_invariant "docker/nginx/nginx.conf"
    cmp "${TEMPLATES_DIR}/docker/nginx/nginx.conf" "$STAGE_DIR/docker/nginx/nginx.conf"
}

@test "copy_invariant: copies top-level file (sail)" {
    set -e
    copy_invariant "sail"
    cmp "${TEMPLATES_DIR}/sail" "$STAGE_DIR/sail"
}

@test "copy_invariant: fails for a missing template" {
    run copy_invariant "docker/nope.conf"
    [ "$status" -ne 0 ]
}

@test "stage_files: STAGE_DIR contains all 15 staged output files" {
    set -e
    stage_files
    for f in "${EXPECTED_FILES[@]}"; do
        [ -f "$STAGE_DIR/$f" ] || { echo "missing $f"; false; }
    done
    [ "$(find "$STAGE_DIR" -type f | wc -l)" -eq 15 ]
}

@test "stage_files: rendered files have a two-line generated header" {
    set -e
    stage_files
    for f in docker-compose.yml docker/php-fpm/Dockerfile; do
        [[ "$(sed -n 1p "$STAGE_DIR/$f")" == "# Generated by docker-laravel-config"* ]]
        sed -n 2p "$STAGE_DIR/$f" | grep -qE 'Source: docker\.answers\.json  Hash: [0-9a-f]{64}$'
    done
    [[ "$(sed -n 1p "$STAGE_DIR/docker/php-fpm/laravel.ini")" == "; Generated by docker-laravel-config"* ]]
}

@test "stage_files: invariant files have no header and equal the template" {
    set -e
    stage_files
    for f in sail docker/nginx/Dockerfile docker/nginx/startup.sh docker/php-fpm/php-fpm-pool.conf docker/php-fpm/docker-entrypoint.sh; do
        cmp "${TEMPLATES_DIR}/$f" "$STAGE_DIR/$f"
    done
}

@test "stage_files: .gitkeep files exist and are empty" {
    set -e
    stage_files
    [ -f "$STAGE_DIR/docker/logs/nginx/.gitkeep" ]
    [ ! -s "$STAGE_DIR/docker/logs/nginx/.gitkeep" ]
    [ -f "$STAGE_DIR/docker/logs/php-fpm/.gitkeep" ]
    [ ! -s "$STAGE_DIR/docker/logs/php-fpm/.gitkeep" ]
}

@test "stage_files: tokens are substituted in rendered files" {
    set -e
    stage_files
    ! grep -rq '{{[A-Z_]*}}' "$STAGE_DIR"
    grep -q 'node:20-alpine' "$STAGE_DIR/docker-compose.yml"
}

@test "stage_files: does not write anything into OUT_DIR" {
    set -e
    stage_files
    [ -z "$(ls -A "$OUT_DIR")" ]
}
